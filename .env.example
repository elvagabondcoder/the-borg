# the-borg Docker configuration
#
# Copy this file to .env (kept out of git — see .gitignore) and edit the
# values below for your machine.
#
#   cp .env.example .env
#   "$EDITOR" .env
#   docker compose up -d --build

# --- Host paths (used only to set up the bind mounts in docker-compose.yml) ---

# Absolute path, on the HOST, to the "ideas" folder inside your Obsidian
# vault. Each direct subfolder of this path is treated as one idea. Mounted
# read-write into the container at /vault/ideas.
VAULT_IDEAS_DIR=/absolute/path/to/YourVault/Ideas

# Absolute path, on the HOST, for machine-generated bookkeeping (content
# hashes, timestamps, logs, the run lockfile). Kept outside the vault on
# purpose so Obsidian sync tools never see it churn on every cron tick.
# Mounted read-write into the container at /state.
STATE_DIR=/absolute/path/to/a/state-dir

# --- Claude Code auth (set exactly one) ---

# A long-lived token from `claude setup-token`, run once on any machine
# where you've already logged in with your Claude subscription. Recommended
# — no separate API billing.
CLAUDE_CODE_OAUTH_TOKEN=

# Or a standalone API key from console.anthropic.com (pay-per-token billing).
ANTHROPIC_API_KEY=

# --- Everything below mirrors config.example.sh; uncomment to override a default ---

# CRON_SCHEDULE=*/30 * * * *
# CLAUDE_MODEL=
# CLAUDE_EXTRA_ARGS=
# MAX_IDEAS_PER_RUN=5
# CLAUDE_TIMEOUT_SECONDS=180
# MAX_RETRIES=1
# MAX_CONTEXT_CHARS=60000
# TODO_FILENAME=TODO.md
# QUESTIONS_FILENAME=QUESTIONS.md
# DONE_SENTINEL_FILENAME=.idea-done

# If true, a done idea is moved to ARCHIVE_DIR instead of just being
# skipped in place. ARCHIVE_DIR defaults to a sibling "Archive" folder next
# to VAULT_IDEAS_DIR, but that default is NOT mounted into the container —
# if you turn this on, also mount an archive directory and set ARCHIVE_DIR
# to its container-side path yourself, or archiving will silently happen
# inside the container's throwaway filesystem.
# ARCHIVE_ON_DONE=false
# ARCHIVE_DIR=

# LOG_RETENTION_DAYS=30
